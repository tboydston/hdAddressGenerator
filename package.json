{
  "name": "hdaddressgenerator",
  "version": "1.2.0",
  "description": "Generate hierarchical deterministic(HD) coin specific crypto addresses ( legacy, segwit, bech32 ) from single master key pair for over 190 different cryptocurrencies.",
  "main": "hdAddressGenerator.js",
  "files": [
    "hdAddressGenerator.js",
    "examples.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "sandboxInjectedGlobals": [
      "Math"
    ],
    "collectCoverageFrom": [
      "hdAddressGenerator.js"
    ]
  },
  "keywords": [
    "crypto",
    "address",
    "generator",
    "hierarchical deterministic",
    "bitcoin",
    "ethereum"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tboydston/hdAddressGenerator.git"
  },
  "author": "Tracey Boydston",
  "license": "MIT",
  "dependencies": {
    "base-x": "^3.0.8",
    "bchaddrjs": "^0.5.2",
    "bchaddrjs-slp": "^0.2.11",
    "bip32": "^2.0.6",
    "bip38": "^3.1.1",
    "bip39": "^3.0.3",
    "bitcoinjs-lib": "^5.2.0",
    "bs58": "^4.0.1",
    "bs58check": "^2.1.2",
    "coinnetworklist": "^1.0.1",
    "create-hash": "^1.2.0",
    "ed25519-hd-key": "^1.1.2",
    "ethereumjs-util": "^7.0.7",
    "nanocurrency-web": "^1.2.2",
    "stellar-base": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.0"
  }
}
